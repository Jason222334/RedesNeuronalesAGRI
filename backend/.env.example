# Variables de entorno — Backend FastAPI
# Copia este archivo a .env y completa los valores

# ── Base de Datos (Supabase PostgreSQL) ──
DATABASE_URL=postgresql://usuario:password@db.supabase.co:5432/postgres

# ── Configuración de Correo SMTP ──
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password
MAIL_FROM=tu_correo@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=AgroJequete Sistema
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
VALIDATE_CERTS=True

# ── URLs de producción ──
FRONTEND_URL=https://agrojequete.vercel.app
BACKEND_URL=https://agrojequete-backend.onrender.com
STREAMLIT_URL=https://agrojequete-streamlit.onrender.com
